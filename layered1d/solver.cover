    1: from __future__ import annotations
       
    1: from dataclasses import dataclass
    1: from typing import Any, Dict, List
    1: import numpy as np
       
       
    3: @dataclass
    2: class FrequencyResponseResult:
    1:     stack: Any
    1:     frequencies_hz: np.ndarray
    1:     nodal_displacements: np.ndarray
    1:     reflection_coefficient: np.ndarray
    1:     transmission_displacement_ratio: np.ndarray
    1:     input_impedance: np.ndarray
    1:     interface_jumps: np.ndarray
    1:     left_boundary_impedance: np.ndarray
    1:     right_boundary_impedance: np.ndarray
    1:     node_positions: np.ndarray
    1:     node_labels: List[str]
    1:     raw_solutions: List[Dict[str, Any]]
       
    2:     @classmethod
    2:     def from_solutions(cls, stack: Any, frequencies_hz: np.ndarray, solutions: List[Dict[str, Any]]) -> "FrequencyResponseResult":
   17:         nodal_displacements = np.vstack([s["u"] for s in solutions])
   17:         reflection_coefficient = np.array([s["reflection_coefficient"] for s in solutions], dtype=complex)
   17:         transmission_displacement_ratio = np.array([s["transmission_displacement_ratio"] for s in solutions], dtype=complex)
   17:         input_impedance = np.array([s["input_impedance"] for s in solutions], dtype=complex)
    8:         interface_jumps = np.vstack([s["interface_jumps"] for s in solutions]) if len(stack.interfaces) > 0 else np.zeros((len(frequencies_hz), 0), dtype=complex)
   17:         left_boundary_impedance = np.array([s["left_boundary_impedance"] for s in solutions], dtype=float)
   17:         right_boundary_impedance = np.array([s["right_boundary_impedance"] for s in solutions], dtype=float)
   10:         return cls(
    5:             stack=stack,
    5:             frequencies_hz=np.asarray(frequencies_hz, dtype=float),
    5:             nodal_displacements=nodal_displacements,
    5:             reflection_coefficient=reflection_coefficient,
    5:             transmission_displacement_ratio=transmission_displacement_ratio,
    5:             input_impedance=input_impedance,
    5:             interface_jumps=interface_jumps,
    5:             left_boundary_impedance=left_boundary_impedance,
    5:             right_boundary_impedance=right_boundary_impedance,
    5:             node_positions=solutions[0]["node_positions"],
    5:             node_labels=solutions[0]["node_labels"],
    5:             raw_solutions=solutions,
               )
       
    2:     @property
    2:     def reflection_magnitude(self) -> np.ndarray:
    1:         return np.abs(self.reflection_coefficient)
       
    2:     @property
    2:     def reflection_phase(self) -> np.ndarray:
    1:         return np.angle(self.reflection_coefficient)
       
    2:     @property
    2:     def input_impedance_magnitude(self) -> np.ndarray:
    1:         return np.abs(self.input_impedance)
       
    2:     @property
    2:     def interface_jump_magnitude(self) -> np.ndarray:
               return np.abs(self.interface_jumps)
       
    2:     @property
    2:     def power_reflectance(self) -> np.ndarray:
    6:         return np.abs(self.reflection_coefficient) ** 2
       
    2:     @property
    2:     def power_transmittance(self) -> np.ndarray:
    6:         return (self.right_boundary_impedance / self.left_boundary_impedance) * np.abs(self.transmission_displacement_ratio) ** 2
       
    2:     @property
    2:     def power_balance(self) -> np.ndarray:
    6:         return self.power_reflectance + self.power_transmittance
       
    1:     def layer_field(self, layer_index: int, frequency_index: int, points: int = 200) -> Dict[str, np.ndarray]:
               layer = self.stack.layers[layer_index]
               dof_left, dof_right = self.stack._connectivity.layer_dofs[layer_index]
               u_left = self.nodal_displacements[frequency_index, dof_left]
               u_right = self.nodal_displacements[frequency_index, dof_right]
               z_local = np.linspace(0.0, layer.thickness, points)
               omega = 2.0 * np.pi * self.frequencies_hz[frequency_index]
               return layer.field(omega, z_local=z_local, u_left=u_left, u_right=u_right)
