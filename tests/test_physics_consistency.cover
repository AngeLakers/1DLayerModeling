    1:     def test_reflection_is_zero_for_impedance_matched_single_layer(self) -> None:
    1:         rho = 1000.0
    1:         nu = 0.25
    1:         longitudinal_wave_speed = 1500.0
    1:         E = isotropic_E_from_normal_longitudinal_speed(rho, longitudinal_wave_speed, nu)
    1:         material = Material(density=rho, young_modulus=E, poisson_ratio=nu, name="Matched")
    1:         layer = Layer.from_material(thickness=1.2e-3, material=material)
    1:         water = HalfSpaceMedium(density=1000.0, longitudinal_wave_speed=1500.0, name="matched")
    1:         stack = LaminatedStack(layers=[layer])
    1:         freqs = np.array([0.2e6, 0.8e6, 1.4e6])
    1:         result = stack.solve_sweep(freqs, left_medium=water, right_medium=water)
    1:         self.assertLess(np.max(np.abs(result.reflection_coefficient)), 1e-10)
       
    1:     def test_medium_object_matches_raw_impedance(self) -> None:
    2:         with self.assertWarns(FutureWarning):
    1:             layer = Layer(thickness=0.6e-3, density=2700.0, young_modulus=70e9, poisson_ratio=0.33)
    1:         freqs = np.array([0.4e6, 1.1e6])
    1:         water = HalfSpaceMedium(density=1000.0, longitudinal_wave_speed=1480.0, name="Water")
    1:         steel = HalfSpaceMedium(density=7850.0, longitudinal_wave_speed=5900.0, name="Steel")
    1:         stack = LaminatedStack(layers=[layer])
    1:         result_obj = stack.solve_sweep(freqs, left_medium=water, right_medium=steel)
    1:         result_raw = stack.solve_sweep(freqs, left_medium_impedance=water.impedance, right_medium_impedance=steel.impedance)
    1:         np.testing.assert_allclose(result_obj.reflection_coefficient, result_raw.reflection_coefficient)
    1:         np.testing.assert_allclose(result_obj.input_impedance, result_raw.input_impedance)
    1:         np.testing.assert_allclose(result_obj.power_balance, result_raw.power_balance)
       
    1:     def test_frequency_response_result_properties_and_layer_field(self) -> None:
    1:         material = Material(density=1000.0, young_modulus=1.875e9, poisson_ratio=0.25, name="WaterLike")
    1:         layer = Layer.from_material(thickness=0.9e-3, material=material)
    1:         stack = LaminatedStack(layers=[layer])
    1:         freqs = np.array([0.25e6, 0.75e6])
    1:         result = stack.solve_sweep(freqs, left_medium_impedance=1.5e6, right_medium_impedance=1.5e6)
    1:         np.testing.assert_allclose(result.reflection_magnitude, np.abs(result.reflection_coefficient))
    1:         np.testing.assert_allclose(result.reflection_phase, np.angle(result.reflection_coefficient))
    1:         np.testing.assert_allclose(result.input_impedance_magnitude, np.abs(result.input_impedance))
    1:         np.testing.assert_allclose(result.power_balance, np.ones_like(result.power_balance), rtol=1e-9, atol=1e-9)
       
    1:     def test_lossless_energy_balance_holds_for_real_boundary_impedances(self) -> None:
    1:         aluminum = Material(density=2700.0, young_modulus=70e9, poisson_ratio=0.33, name="Aluminum")
    1:         polymer = Material(density=1200.0, young_modulus=3e9, poisson_ratio=0.40, name="Polymer")
    1:         composite = Material(density=1600.0, young_modulus=8e9, poisson_ratio=0.30, name="Composite")
    1:         layers = [
    1:             Layer.from_material(thickness=0.8e-3, material=aluminum),
    1:             Layer.from_material(thickness=0.3e-3, material=polymer),
    1:             Layer.from_material(thickness=1.1e-3, material=composite),
               ]
    1:         interfaces = [InterfaceSpring(4e13), InterfaceSpring(8e12)]
    1:         stack = LaminatedStack(layers=layers, interfaces=interfaces)
    1:         left = HalfSpaceMedium(density=1000.0, longitudinal_wave_speed=1480.0)
    1:         right = HalfSpaceMedium(density=7850.0, longitudinal_wave_speed=5900.0)
    1:         freqs = np.array([0.2e6, 0.8e6, 1.6e6])
    1:         result = stack.solve_sweep(freqs, left_medium=left, right_medium=right)
    1:         np.testing.assert_allclose(result.power_balance, np.ones_like(result.power_balance), rtol=1e-9, atol=1e-9)
       
       
