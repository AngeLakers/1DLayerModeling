    5: def isotropic_E_from_normal_longitudinal_speed(
    1:     rho: float,
    1:     longitudinal_wave_speed: float,
    1:     nu: float,
    1: ) -> float:
    2:     return (
   12:         rho
    2:         * longitudinal_wave_speed
    2:         * longitudinal_wave_speed
    2:         * (1.0 + nu)
    2:         * (1.0 - 2.0 * nu)
    2:         / (1.0 - nu)
           )
       
       
    2: class PhysicsConsistencyTests(unittest.TestCase):
    1:     def test_material_derives_wave_speeds_and_impedance(self) -> None:
    2:         material = Material(
    1:             density=2700.0,
    1:             young_modulus=70e9,
    1:             poisson_ratio=0.33,
    1:             name="Aluminum",
               )
    1:         self.assertGreater(material.longitudinal_wave_speed, material.shear_wave_speed)
    1:         self.assertGreater(material.impedance, 0.0)
    1:         self.assertGreater(material.longitudinal_modulus, material.young_modulus)
       
    1:     def test_material_requires_poisson_ratio(self) -> None:
    2:         with self.assertRaisesRegex(TypeError, "poisson_ratio"):
    1:             Material(density=2700.0, young_modulus=70e9, name="Aluminum")
    2:         with self.assertRaisesRegex(ValueError, "poisson_ratio must be provided"):
    1:             Material(density=2700.0, young_modulus=70e9, poisson_ratio=None, name="Aluminum")
       
    1:     def test_layer_legacy_constructor_requires_poisson_ratio(self) -> None:
    2:         with self.assertRaisesRegex(ValueError, "poisson_ratio must be provided"):
    1:             Layer(thickness=1.0e-3, density=2700.0, young_modulus=70e9)
    2:         with self.assertRaisesRegex(ValueError, "poisson_ratio must be finite"):
    1:             Layer(thickness=1.0e-3, density=2700.0, young_modulus=70e9, poisson_ratio=float("nan"))
       
    1:     def test_layer_can_be_built_from_material_or_legacy_properties(self) -> None:
    1:         material = Material(density=2700.0, young_modulus=70e9, poisson_ratio=0.33, name="Aluminum")
    1:         layer_from_material = Layer.from_material(thickness=1.0e-3, material=material, name="Al-1")
    2:         with self.assertWarns(FutureWarning):
    2:             layer_legacy = Layer(
    1:                 thickness=1.0e-3,
    1:                 density=2700.0,
    1:                 young_modulus=70e9,
    1:                 poisson_ratio=0.33,
    1:                 name="Al-1",
                   )
    1:         omega = 2.0 * math.pi * 0.8e6
    1:         np.testing.assert_allclose(layer_from_material.dynamic_stiffness(omega), layer_legacy.dynamic_stiffness(omega))
    1:         self.assertEqual(layer_from_material.material.name, "Aluminum")
    1:         self.assertEqual(layer_from_material.name, "Al-1")
       
    1:     def test_layer_legacy_constructor_carries_material_metadata(self) -> None:
    2:         with self.assertWarns(FutureWarning):
    2:             layer = Layer(
    1:                 thickness=1.0e-3,
    1:                 density=2700.0,
    1:                 young_modulus=70e9,
    1:                 poisson_ratio=0.33,
    1:                 attenuation_alpha=12.0,
